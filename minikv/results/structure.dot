digraph KV {
 rankdir=LR; node [shape=record,fontname="Arial"];
 buckets [label="Hash bucket array|bucket[h] → Request A|bucket[j] → Request B|... (4093 buckets)"];
 reqA [label="Request A|id=A; tokenCount=9|head → node0|tail → node2|hashNext → ..."];
 node0 [label="BlockNode|index=0|next → node1"];
 node1 [label="BlockNode|index=1|next → node2"];
 node2 [label="BlockNode|index=4|next=null"];
 mem [label="Physical Block array|{0|owner=A; used=4}|{1|owner=A; used=4}|{2|owner=B; used=4}|{3|owner=B; used=4}|{4|owner=A; used=1}|{5|free}|..."];
 buckets -> reqA [label="hash-chain pointer"];
 reqA -> node0 [label="logical head"];
 node0 -> node1 -> node2 [label="next"];
 node0 -> mem [style=dashed,label="index selects Block 0"];
 node2 -> mem [style=dashed,label="index selects Block 4"];
}
